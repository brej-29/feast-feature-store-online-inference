# Example environment configuration.
# Copy this file to `.env` and fill in real values for local development.
# Do NOT commit `.env` to version control.

# --- Application (shared) ---
# Port exposed by Nginx inside the container (HF Spaces will override this)
PORT=7860

# Base URL where the FastAPI API is reachable from the Gradio app.
# - For local dev (no Nginx): http://127.0.0.1:8000
# - For Docker/Nginx:        http://127.0.0.1:8000 (Gradio runs inside the container)
API_BASE_URL=http://127.0.0.1:8000

# --- Local docker-compose Postgres (development only) ---
# Example compose URL:
# POSTGRES_URL=postgresql://feature_user:feature_pass@postgres:5432/feature_store
POSTGRES_URL=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=feature_user
POSTGRES_PASSWORD=feature_pass
POSTGRES_DB=feature_store

# --- Managed Postgres (Neon / Supabase) placeholders ---
# Use these to point Feast's online store at a managed instance.
# POSTGRES_HOST=<your-neon-or-supabase-host>
# POSTGRES_PORT=5432
# POSTGRES_DB=<your-db-name>
# POSTGRES_USER=<your-db-user>
# POSTGRES_PASSWORD=<your-db-password>

# --- Kafka / CloudKarafka ---
# Local Redpanda broker (docker-compose):
# KAFKA_BROKERS=redpanda:9092
KAFKA_BROKERS=
KAFKA_TOPIC=txn_events

# CloudKarafka free tier example wiring (do not commit real secrets):
CLOUDKARAFKA_BROKERS=
CLOUDKARAFKA_USERNAME=
CLOUDKARAFKA_PASSWORD=
CLOUDKARAFKA_TOPIC_PREFIX=

# --- Feature store / Feast placeholders ---
FEAST_PROJECT_NAME=fraud_feature_store
FEAST_REPO_PATH=feature_repo

# --- Model serving ---
# Path to the trained model bundle produced by pipelines/train_model.py
MODEL_PATH=models/fraud_model_v2.joblib

# Optional API key for /api/predict. Leave unset for local dev (auth
# disabled). Set before exposing the API publicly; the Gradio UI reads the
# same value to attach the X-API-Key header automatically.
API_KEY=

# --- Monitoring ---
PROMETHEUS_SCRAPE_INTERVAL=15s